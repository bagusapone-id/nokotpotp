{
  "rules": {
    "$root": {
      ".read": "false",
      ".write": "false"
    },

    "users": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "false",
        ".indexOn": ["username"]
      }
    },

    "orders": {
      ".indexOn": ["user_id"],
      "$orderId": {
        ".read": "auth !== null && data.child('user_id').val() === auth.uid",
        ".write": "false"
      }
    },

    "deposits": {
      ".indexOn": ["user_id", "order_id"],
      "$depositId": {
        ".read": "auth !== null && data.child('user_id').val() === auth.uid",
        ".write": "false"
      }
    },

    "withdrawal_requests": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "false"
      }
    },

    "countries": {
      ".read": "auth !== null",
      ".write": "false"
    },

    "phone_stocks": {
      ".read": "false",
      ".write": "false"
    },

    "referral_codes": {
      ".read": "false",
      ".write": "false"
    },

    "referral_attributions": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "false"
      }
    },

    "referrals": {
      "$referrerId": {
        ".read": "auth !== null && auth.uid === $referrerId",
        ".write": "false"
      }
    },

    "notifications": {
      ".read": "auth !== null",
      ".write": "false"
    },

    "events": {
      ".read": "auth !== null",
      ".write": "false"
    }
  }
}
