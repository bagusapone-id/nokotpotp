# ─────────────────────────────────────────────────────────────
# NOKOTPOTP — Environment Variables Template
# Salin file ini ke .env lalu isi dengan nilai asli.
# JANGAN pernah commit .env ke git.
# ─────────────────────────────────────────────────────────────

# ── Firebase Admin SDK ────────────────────────────────────────
# Project ID dari Firebase Console
FIREBASE_PROJECT_ID=your-firebase-project-id

# Client email dari service account (Settings > Service Accounts)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Private key dari service account JSON.
# Di .env lokal: paste dengan \n literal antar baris.
# Di Vercel: gunakan FIREBASE_PRIVATE_KEY_B64 (base64) untuk hindari masalah multiline.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Alternatif untuk Vercel (base64-encoded dari private key):
# FIREBASE_PRIVATE_KEY_B64=base64encodedkeyhere

# Realtime Database URL
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# ── Admin Access ──────────────────────────────────────────────
# UID Firebase user yang akan dijadikan admin pertama.
# Dapatkan dari Firebase Console > Authentication > Users.
# Setelah setup, sebaiknya pakai custom claim (firebase admin:true) saja.
ADMIN_SECRET_UID=your-admin-firebase-uid

# ── Telegram Notification ─────────────────────────────────────
# Bot token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat ID tujuan notifikasi (bisa personal chat ID atau group ID)
# Cara dapat: kirim pesan ke bot, lalu buka https://api.telegram.org/bot<TOKEN>/getUpdates
ADMIN_CHAT_ID=your-telegram-chat-id

# ── Pakasir Payment Gateway ───────────────────────────────────
# Slug merchant Pakasir (dari dashboard Pakasir)
PAKASIR_SLUG=your-pakasir-merchant-slug

# API Key dari dashboard Pakasir
PAKASIR_API_KEY=your-pakasir-api-key

# Webhook secret — isi bebas, harus sama persis dengan yang di-set di dashboard Pakasir
PAKASIR_WEBHOOK_SECRET=your-random-webhook-secret-string

# ── Server ────────────────────────────────────────────────────
# Port untuk development lokal (Vercel tidak pakai ini)
PORT=3000
