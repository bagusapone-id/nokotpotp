FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=replace-with-service-account-private-key
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com

TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
ADMIN_SECRET_UID=

# ── Duitku Payment Gateway ───────────────────────────────────────────────────
# Daftar di: https://dashboard.duitku.com → Settings → Project
DUITKU_MERCHANT_CODE=        # Merchant Code dari dashboard Duitku (cth: DS12345)
DUITKU_API_KEY=              # API Key dari dashboard Duitku
DUITKU_CALLBACK_URL=         # URL callback kamu (cth: https://domain.com/api/deposit/callback)
DUITKU_RETURN_URL=           # URL redirect setelah bayar (cth: https://domain.com)
DUITKU_MODE=sandbox          # sandbox atau production

# ── Pakasir (DEPRECATED — akan dihapus setelah migrasi selesai) ──────────────
PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_WEBHOOK_SECRET=

PORT=3000
